{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bandfeed",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-28",
	"routes": [
		{
			"pattern": "bandfeed.viniciusdof.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
